/*
注意：wrangler.jsonc 現在預設 ENFORCE_ACCESS=1。部署時需要提供 ACCESS_TEAM_DOMAIN 和 ACCESS_AUD；本地 wrangler dev 若要略過 Access，可在 .dev.vars 設 ENFORCE_ACCESS=0。
*/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netsuke-cmyk",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "CONTAINER_INSTANCES": "1",
    "ENFORCE_ACCESS": "1"
  },
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "PdfConverter",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "PdfConverter", "name": "PDF_CONVERTER" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PdfConverter"] }
  ]
}
